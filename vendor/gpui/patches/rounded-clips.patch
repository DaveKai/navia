+/// A rounded clip in window pixels, inside its parent's.
+#[derive(Debug, PartialEq)]
+pub(crate) struct RoundedClipRegion {
+    bounds: Bounds<Pixels>,
+    corners: Corners<Pixels>,
+    parent: Option<Arc<RoundedClipRegion>>,
+}
+
+impl RoundedClipRegion {
+    /// Whether `position` is inside this clip and every clip around it.
+    fn contains(&self, position: Point<Pixels>) -> bool {
+        if !self.bounds.contains(&position) {
+            return false;
+        }
+        let offset = position - self.bounds.origin;
+        let (width, height) = (self.bounds.size.width, self.bounds.size.height);
+        let (radius, horizontal, vertical) = if offset.x < width / 2.0 {
+            if offset.y < height / 2.0 { (self.corners.top_left, offset.x, offset.y) } else { (self.corners.bottom_left, offset.x, height - offset.y) }
+        } else if offset.y < height / 2.0 {
+            (self.corners.top_right, width - offset.x, offset.y)
+        } else {
+            (self.corners.bottom_right, width - offset.x, height - offset.y)
+        };
+        let inside = horizontal >= radius
+            || vertical >= radius
+            || f32::from(horizontal - radius).powi(2) + f32::from(vertical - radius).powi(2) <= f32::from(radius).powi(2);
+        inside && self.parent.as_ref().is_none_or(|parent| parent.contains(position))
+    }
+}
