+    /// Writes the scene's rounded clips where the shaders read them, growing the table first
+    /// when it is too small (and shrinking it when it is far too big).
+    fn upload_rounded_clips(&mut self, scene: &Scene) -> Result<()> {
+        const TEXELS_PER_CLIP: usize = 3;
+        let height = ((scene.rounded_clips.len() * TEXELS_PER_CLIP).div_ceil(ROUNDED_CLIP_TEXTURE_WIDTH as usize).max(1) as u32).next_power_of_two();
+        anyhow::ensure!(height <= self.max_texture_size, "rounded clip table exceeds the texture limit");
+        let (path_offset, gamma_offset) = (self.path_globals_offset, self.gamma_offset);
+        let resources = self.resources_mut();
+        let current = resources.rounded_clip_texture.height();
+        if current < height || current > height.saturating_mul(4) {
+            resources.rounded_clip_texture = create_rounded_clip_texture(&resources.device, height);
+            resources.rounded_clip_view = resources.rounded_clip_texture.create_view(&Default::default());
+            let (globals, path_globals) = create_globals_bind_groups(
+                &resources.device,
+                &resources.bind_group_layouts.globals,
+                &resources.globals_buffer,
+                path_offset,
+                gamma_offset,
+                &resources.rounded_clip_view,
+            );
+            resources.globals_bind_group = globals;
+            resources.path_globals_bind_group = path_globals;
+        }
+        if scene.rounded_clips.is_empty() {
+            return Ok(());
+        }
+        let rows = (scene.rounded_clips.len() * TEXELS_PER_CLIP).div_ceil(ROUNDED_CLIP_TEXTURE_WIDTH as usize) as u32;
+        let row_bytes = ROUNDED_CLIP_TEXTURE_WIDTH as usize * 16;
+        let mut bytes = vec![0u8; rows as usize * row_bytes];
