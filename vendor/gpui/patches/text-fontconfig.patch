+//! Text rendering settings from the system's font configuration.
+//!
+//! On Linux and FreeBSD the desktop's antialiasing, subpixel order and hinting
+//! choices live in fontconfig (KDE's font settings write them there, and
+//! distributions ship defaults in `/etc/fonts/conf.d`). This module asks
+//! fontconfig what it would hand a renderer for a family, the way Qt and cairo
+//! do, and maps the answer onto what swash and the subpixel shader can do:
+//!
+//! | fontconfig                         | rendering                                   |
+//! |------------------------------------|---------------------------------------------|
+//! | `antialias` false                  | grayscale mask thresholded to 1 bit         |
+//! | `rgba` none or unknown             | [`TextRenderingMode::Grayscale`]            |
+//! | `rgba` rgb or bgr                  | subpixel in that order, over the display's  |
+//! | `rgba` vrgb or vbgr                | grayscale: swash has no vertical subpixel   |
+//! | `rgba` not set                     | subpixel in the order the display reports   |
+//! | `hinting` false or `hintstyle` none| swash hinting off                           |
+//! | `hintstyle` slight, medium, full   | swash hinting on                            |
+//!
+//! swash has a single hinting mode, so slight, medium and full all map to it.
+//! `lcdfilter` is not applied: swash's subpixel format uses its own filter.
+//!
+//! libfontconfig is opened at runtime. Without it, or on other platforms, the
+//! defaults keep the previous behaviour: antialiased, hinted, subpixel.
+
+use gpui::TextRenderingMode;
+
+/// The subpixel arrangement fontconfig's `rgba` names.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SubpixelOrder {
+    /// `none` or `unknown`: no subpixel rendering.
+    None,
+    Rgb,
+    Bgr,
+    VerticalRgb,
+    VerticalBgr,
+}
+
+/// How glyphs of one family should be rasterized, as the font configuration says.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct FontRenderingSettings {
+    /// fontconfig `antialias`.
+    pub antialias: bool,
+    /// fontconfig `hinting`, and `hintstyle` other than none.
+    pub hinting: bool,
+    /// fontconfig `rgba`, when the configuration sets it. `None` leaves the order
+    /// to the display.
+    pub subpixel_order: Option<SubpixelOrder>,
+}
+
+impl Default for FontRenderingSettings {
+    fn default() -> Self {
+        Self {
+            antialias: true,
+            hinting: true,
+            subpixel_order: None,
+        }
+    }
+}
+
+impl FontRenderingSettings {
+    /// The settings for the default font, what `fc-match` with no pattern resolves.
+    /// Queried once per process.
+    pub fn system() -> Self {
+        imp::system()
+    }
+
+    /// The settings for one family, so rules that target a family apply. The font
+    /// doesn't have to be installed: the query uses the family name alone. Cached.
+    pub fn for_family(family: &str) -> Self {
+        imp::for_family(family)
+    }
+
+    /// The rendering mode to recommend when the application leaves it to the platform.
+    pub fn rendering_mode(&self) -> TextRenderingMode {
+        if !self.antialias {
+            return TextRenderingMode::Grayscale;
+        }
+        match self.subpixel_order {
+            None | Some(SubpixelOrder::Rgb | SubpixelOrder::Bgr) => TextRenderingMode::Subpixel,
+            Some(
+                SubpixelOrder::None | SubpixelOrder::VerticalRgb | SubpixelOrder::VerticalBgr,
+            ) => TextRenderingMode::Grayscale,
+        }
+    }
+
+    /// Whether subpixels are blue, green, red, when the configuration says so.
+    /// `None` means the display's report should decide.
+    pub fn is_bgr(&self) -> Option<bool> {
+        match self.subpixel_order {
+            Some(SubpixelOrder::Rgb) => Some(false),
+            Some(SubpixelOrder::Bgr) => Some(true),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+mod imp {
+    use super::{FontRenderingSettings, SubpixelOrder};
+    use collections::HashMap;
+    use fontconfig_sys::{
+        FcConfig, FcMatchPattern, FcPattern, FcResultMatch, constants::*, statics::LIB_RESULT,
+    };
+    use parking_lot::Mutex;
+    use std::{
+        ffi::{CStr, CString, c_int},
+        sync::LazyLock,
+    };
+
+    struct Query {
+        /// Loaded without scanning fonts: the settings need the rules, not the fonts.
+        config: *mut FcConfig,
+        system: Option<FontRenderingSettings>,
+        families: HashMap<String, FontRenderingSettings>,
+    }
+
+    // SAFETY: the config is only touched while the mutex is held.
+    unsafe impl Send for Query {}
+
+    static QUERY: LazyLock<Mutex<Option<Query>>> = LazyLock::new(|| {
+        let fc = match LIB_RESULT.as_ref() {
+            Ok(fc) => fc,
+            Err(error) => {
+                log::info!("fontconfig not available ({error}), using default text rendering");
+                return Mutex::new(None);
+            }
+        };
+        // SAFETY: FcInitLoadConfig has no preconditions; a null result is handled.
+        let config = unsafe { (fc.FcInitLoadConfig)() };
+        if config.is_null() {
+            log::warn!("fontconfig could not load its configuration, using default text rendering");
+            return Mutex::new(None);
+        }
+        Mutex::new(Some(Query {
+            config,
+            system: None,
+            families: HashMap::default(),
+        }))
+    });
+
+    pub(super) fn system() -> FontRenderingSettings {
+        let mut query = QUERY.lock();
+        let Some(query) = query.as_mut() else {
+            return FontRenderingSettings::default();
+        };
+        *query.system.get_or_insert_with(|| {
+            let settings = resolve(query.config, None);
+            log::info!("text rendering from fontconfig: {settings:?}");
+            settings
+        })
+    }
+
+    pub(super) fn for_family(family: &str) -> FontRenderingSettings {
+        let mut query = QUERY.lock();
+        let Some(query) = query.as_mut() else {
+            return FontRenderingSettings::default();
+        };
+        if let Some(settings) = query.families.get(family) {
+            return *settings;
+        }
+        let settings = match CString::new(family) {
+            Ok(name) => resolve(query.config, Some(&name)),
+            Err(_) => resolve(query.config, None),
+        };
+        query.families.insert(family.to_string(), settings);
+        settings
+    }
+
+    /// Runs the substitutions a renderer would see for `family`: the pattern rules,
+    /// fontconfig's defaults, then the font rules for a scalable outline font of
+    /// that family (`FcFontRenderPrepare`, as cairo does for fonts it didn't get
+    /// from fontconfig). With no family, the default family is resolved first.
+    fn resolve(config: *mut FcConfig, family: Option<&CStr>) -> FontRenderingSettings {
+        let Ok(fc) = LIB_RESULT.as_ref() else {
+            return FontRenderingSettings::default();
+        };
+        // SAFETY: every pattern created here is destroyed before returning, and
+        // strings read from a pattern are copied before it is destroyed.
+        unsafe {
+            let pattern = (fc.FcPatternCreate)();
+            if pattern.is_null() {
+                return FontRenderingSettings::default();
+            }
+            if let Some(family) = family {
+                (fc.FcPatternAddString)(pattern, FC_FAMILY.as_ptr(), family.as_ptr().cast());
+            }
+            (fc.FcConfigSubstitute)(config, pattern, FcMatchPattern);
+            (fc.FcDefaultSubstitute)(pattern);
+
+            let font = (fc.FcPatternCreate)();
+            if font.is_null() {
+                (fc.FcPatternDestroy)(pattern);
+                return FontRenderingSettings::default();
+            }
+            let mut name = std::ptr::null_mut();
+            if (fc.FcPatternGetString)(pattern, FC_FAMILY.as_ptr(), 0, &mut name) == FcResultMatch
+                && !name.is_null()
+            {
+                (fc.FcPatternAddString)(font, FC_FAMILY.as_ptr(), name);
+            }
+            (fc.FcPatternAddBool)(font, FC_OUTLINE.as_ptr(), 1);
+            (fc.FcPatternAddBool)(font, FC_SCALABLE.as_ptr(), 1);
+
+            let prepared = (fc.FcFontRenderPrepare)(config, pattern, font);
+            (fc.FcPatternDestroy)(font);
+            (fc.FcPatternDestroy)(pattern);
+            if prepared.is_null() {
+                return FontRenderingSettings::default();
+            }
+            let settings = read(prepared);
+            (fc.FcPatternDestroy)(prepared);
+            settings
+        }
+    }
+
+    /// SAFETY: `pattern` must be a valid fontconfig pattern.
+    unsafe fn read(pattern: *mut FcPattern) -> FontRenderingSettings {
+        let Ok(fc) = LIB_RESULT.as_ref() else {
+            return FontRenderingSettings::default();
+        };
+        let get_bool = |object: &CStr| {
+            let mut value = 0;
+            let found =
+                unsafe { (fc.FcPatternGetBool)(pattern, object.as_ptr(), 0, &mut value) };
+            (found == FcResultMatch).then_some(value != 0)
+        };
+        let get_int = |object: &CStr| {
+            let mut value: c_int = 0;
+            let found =
+                unsafe { (fc.FcPatternGetInteger)(pattern, object.as_ptr(), 0, &mut value) };
+            (found == FcResultMatch).then_some(value)
+        };
+
+        let hintstyle = get_int(FC_HINT_STYLE).unwrap_or(FC_HINT_FULL);
+        FontRenderingSettings {
+            antialias: get_bool(FC_ANTIALIAS).unwrap_or(true),
+            hinting: get_bool(FC_HINTING).unwrap_or(true) && hintstyle != FC_HINT_NONE,
+            subpixel_order: get_int(FC_RGBA).map(|rgba| match rgba {
+                FC_RGBA_RGB => SubpixelOrder::Rgb,
+                FC_RGBA_BGR => SubpixelOrder::Bgr,
+                FC_RGBA_VRGB => SubpixelOrder::VerticalRgb,
+                FC_RGBA_VBGR => SubpixelOrder::VerticalBgr,
+                _ => SubpixelOrder::None,
+            }),
+        }
+    }
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "freebsd")))]
+mod imp {
+    use super::FontRenderingSettings;
+
+    pub(super) fn system() -> FontRenderingSettings {
+        FontRenderingSettings::default()
+    }
+
+    pub(super) fn for_family(_family: &str) -> FontRenderingSettings {
+        FontRenderingSettings::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rendering_mode_follows_rgba_and_antialias() {
+        let with = |antialias, subpixel_order| FontRenderingSettings {
+            antialias,
+            hinting: true,
+            subpixel_order,
+        };
+        use SubpixelOrder::*;
+        use TextRenderingMode::{Grayscale, Subpixel};
+        assert_eq!(with(true, None).rendering_mode(), Subpixel);
+        assert_eq!(with(true, Some(Rgb)).rendering_mode(), Subpixel);
+        assert_eq!(with(true, Some(Bgr)).rendering_mode(), Subpixel);
+        assert_eq!(with(true, Some(SubpixelOrder::None)).rendering_mode(), Grayscale);
+        assert_eq!(with(true, Some(VerticalRgb)).rendering_mode(), Grayscale);
+        assert_eq!(with(false, Some(Rgb)).rendering_mode(), Grayscale);
+        assert_eq!(with(true, Some(Bgr)).is_bgr(), Some(true));
+        assert_eq!(with(true, Some(Rgb)).is_bgr(), Some(false));
+        assert_eq!(with(true, None).is_bgr(), Option::None);
+    }
+}
