diff -ruN a/crates/gpui_windows/src/directx_renderer/backdrop_blur.rs b/crates/gpui_windows/src/directx_renderer/backdrop_blur.rs
--- a/crates/gpui_windows/src/directx_renderer/backdrop_blur.rs
