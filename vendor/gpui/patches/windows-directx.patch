+
+float4 shadow_fragment(ShadowFragmentInput input): SV_TARGET {
+    float4 color = shadow_fragment_unclipped(input);
+    color.a *= rounded_clip_coverage(shadows[input.shadow_id].rounded_clip, input.position.xy);
+    return color;
+}
