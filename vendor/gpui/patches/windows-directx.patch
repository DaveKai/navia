+/// `Scene::rounded_clips`, which every pixel shader reads at t2 (`rounded_clip_coverage`).
+struct RoundedClipBuffer {
+    buffer: ID3D11Buffer,
+    view: Option<ID3D11ShaderResourceView>,
+    capacity: usize,
+}
+
+impl RoundedClipBuffer {
+    fn new(device: &ID3D11Device) -> Result<Self> {
+        let capacity = 64;
+        let buffer = create_buffer(device, std::mem::size_of::<RoundedClipNode>(), capacity)?;
+        let view = create_buffer_view(device, &buffer)?;
+        Ok(Self { buffer, view, capacity })
+    }
+
+    fn upload(
+        &mut self,
+        device: &ID3D11Device,
+        device_context: &ID3D11DeviceContext,
+        clips: &[RoundedClipNode],
+    ) -> Result<()> {
+        if clips.is_empty() {
+            return Ok(());
+        }
+        if self.capacity < clips.len() {
+            let capacity = clips.len().next_power_of_two();
+            let buffer = create_buffer(device, std::mem::size_of::<RoundedClipNode>(), capacity)?;
+            self.view = create_buffer_view(device, &buffer)?;
+            self.buffer = buffer;
+            self.capacity = capacity;
+        }
+        update_buffer(device_context, &self.buffer, clips)?;
+        unsafe { device_context.PSSetShaderResources(2, Some(slice::from_ref(&self.view))) };
+        Ok(())
+    }
 }
 
