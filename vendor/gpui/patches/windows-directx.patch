+// Rounded clips (gpui Scene::rounded_clips): a primitive's `rounded_clip` is a one-based index
+// into this buffer, 0 for none. Each clip names its parent the same way, so nested clips
+// intersect. Parents are always pushed before their children.
+struct RoundedClip {
+    Bounds bounds;
+    Corners corner_radii;
+    uint parent;
+    uint3 pad;
+};
+
+StructuredBuffer<RoundedClip> rounded_clips: register(t2);
+
+// How much of the pixel at `position` is inside clip `first` and every clip around it.
+float rounded_clip_coverage(uint first, float2 position) {
+    uint index = first;
+    float coverage = 1.0;
+    [loop]
+    for (uint depth = 0u; depth < 64u && index != 0u; depth++) {
+        RoundedClip clip = rounded_clips[index - 1u];
+        coverage = min(coverage, saturate(0.5 - quad_sdf(position, clip.bounds, clip.corner_radii)));
+        index = clip.parent;
+    }
+    return coverage;
+}
