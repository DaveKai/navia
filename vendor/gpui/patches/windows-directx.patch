+float4 quad_fragment(QuadFragmentInput input): SV_Target {
+    float4 color = quad_fragment_unclipped(input);
+    color.a *= rounded_clip_coverage(quads[input.quad_id].rounded_clip, input.position.xy);
+    return color;
